# Local-only values. Copy this file to .env and adjust. Never put a real credential here.

# "local" for development and tests; "prod" only on the deployed service.
ENV=local

# The writer login. It is OFF here so a fresh local run needs no sign-in.
# In production it MUST be true (the service refuses to start otherwise).
# To try the login locally, set BASIC_AUTH_ENABLED=true and fill in both values below.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Local PostgreSQL started by Docker Compose (placeholder password, local-only).
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5432/docs_dev
# Tests read TEST_DATABASE_URL (never DATABASE_URL). The name must end in _test and the host must be local.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5433/docs_test

# Optional extra: AI draft generation with Claude. OFF by default. To try it, set AI_ENABLED=true and put
# your own key in your local .env (never commit it). Cost is capped by prepaid credit on your account.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the web app reaches the API (a runtime-only server variable).
API_BASE_URL=http://localhost:8000
